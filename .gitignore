# Local dependencies
node_modules/

# Environment and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Logs, temporary files, and test output
*.log
*.tmp
*.temp
coverage/
test-results/

# Local user data and editor/OS files
data/
*.sqlite
*.sqlite3
.DS_Store
.idea/
.vscode/

# Keep the production bundle in dist/ tracked.

# Claude Code local session/config
.claude/
.zcode/
.zcodeignore

# Server-local diagnostic activation; never distribute it with the extension.
diagnostics.local.json

# Scratch area for tools/perf-audit. The audit harness materializes recall-selector
# variants here so it never writes next to src/; fully regenerable, never committed.
.perf-audit-scratch/
